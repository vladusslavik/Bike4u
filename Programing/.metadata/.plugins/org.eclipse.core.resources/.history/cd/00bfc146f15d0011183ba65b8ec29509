uint8_t ble_buf[247];

uint8_t buf_ble[100];

void Write(uint16_t delay, const char *COMMAND) {
	//
	memset(buf_ble, 0, sizeof(buf_ble));
	//

    HAL_UART_Transmit(HUART_BLE, (uint8_t*)COMMAND, strlen(COMMAND), 100);
    HAL_Delay(delay);
}

void Swap_BaundRate(uint32_t baundrate){

	uint32_t clock = 32000000;
	USART2->CR1 &= ~USART_CR1_UE;

	USART2->BRR = (clock + (baundrate / 2)) / baundrate;

	USART2->CR1 |= USART_CR1_UE;



}


void Enter_AT_Mode_During_Connect(void) {
    HAL_Delay(1000);
    // Плюси шлемо строго без \r\n через стандартний Transmit
    HAL_UART_Transmit(HUART_BLE, (uint8_t*)"+++", 3, 100);
    HAL_Delay(1000);
}

void Init_BLE(void) {

    Swap_BaundRate(baudrate);
    HAL_UARTEx_ReceiveToIdle_DMA(HUART_BLE, buf_ble, sizeof(buf_ble));

    Write(100, BLEMTU);

    Write(100, ECHO_OFF);

    Write(150, UARTCFG);


    Write(100, BLENAME);
    Write(100, BLEMODE);
    Write(100, BLEMTU);
    Write(100, BLEADVINTV);
    Write(100, BLEADVEN);


    memset(buf_ble, 0, sizeof(buf_ble));


    HAL_UARTEx_ReceiveToIdle_DMA(HUART_BLE, buf_ble, sizeof(buf_ble));
}
