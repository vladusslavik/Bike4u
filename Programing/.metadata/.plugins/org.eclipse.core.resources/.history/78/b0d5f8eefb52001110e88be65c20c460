void EnableTransmit(uint16_t size, volatile uint8_t *addres_memory){

	DMA1_Channel3->CCR &= ~DMA_CCR_EN;

	DMA1->IFCR = DMA_IFCR_CGIF3 |
	                 DMA_IFCR_CTCIF3 |
	                 DMA_IFCR_CHTIF3 |
	                 DMA_IFCR_CTEIF3;

	CS_LOW;
	DCX_DATA;
	DMA1_Channel3->CNDTR = size;
	DMA1_Channel3->CMAR = (uint32_t)addres_memory;

	DMA1_Channel3->CCR |= DMA_CCR_EN;

}

void WriteCmd(uint8_t command){

	CS_LOW;

	while(SPI1->SR & SPI_SR_BSY);
	DCX_CMD;
	SPI1->CR1 |= SPI_CR1_SPE;
	SPI1->DR = command;

	while(!(SPI1->SR & SPI_SR_TXE));
	while(SPI1->SR & SPI_SR_BSY);
	CS_HIGH;
}
