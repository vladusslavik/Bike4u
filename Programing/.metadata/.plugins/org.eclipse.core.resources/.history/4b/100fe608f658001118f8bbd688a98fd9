void DrawPicture(const uint8_t* data) {
    uint8_t cmd;

    cmd = 0x2A; // CASET
    WriteCmd(cmd);
    uint8_t caset[4] = {0x00, 0x00, 0x00, 0xEF};
    WriteParameters(caset, 4);

    cmd = 0x2B; // RASET
    WriteCmd(cmd);
    uint8_t raset[4] = {
        (Y_OFFSET >> 8) & 0xFF,
        (Y_OFFSET) & 0xFF,
        ((Y_OFFSET + 279) >> 8) & 0xFF,
        ((Y_OFFSET + 279) & 0xFF)
    };
    WriteParameters(raset, 4);

    cmd = 0x2C; // RAMWR
    WriteCmd(cmd);

    while(SPI1->SR & SPI_SR_BSY);

    DCX_DATA;
    CS_LOW;

    uint32_t total_bytes = 240 * 280 * 3; // 201,600 байтів

    for (uint32_t i = 0; i < total_bytes; i++) {
        while (!(SPI1->SR & SPI_SR_TXE));
        SPI1->DR = data[i];
    }

    while(SPI1->SR & SPI_SR_BSY);
    CS_HIGH;
}

void ST7789_SetScrollArea(uint16_t tfa, uint16_t vsa, uint16_t bfa) {
    WriteCmd(VSCRDEF);
    uint8_t data[6];
    data[0] = tfa >> 8; // Top Fixed Area (верхня нерухома зона)
    data[1] = tfa & 0xFF;
    data[2] = vsa >> 8; // Vertical Scrolling Area (зона самого скролу)
    data[3] = vsa & 0xFF;
    data[4] = bfa >> 8; // Bottom Fixed Area (нижня нерухома зона)
    data[5] = bfa & 0xFF;
    WriteParameters(data, 6);
}
void ST7789_SetScrollAddress(uint16_t vsp) {
    WriteCmd(VSCSAD);
    uint8_t data[2];
    data[0] = vsp >> 8;
    data[1] = vsp & 0xFF;
    WriteParameters(data, 2);
}
