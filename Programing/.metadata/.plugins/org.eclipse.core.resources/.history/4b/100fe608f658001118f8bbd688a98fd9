void InitDMA(){

	/////************InitDMAtoSPI************/////

	SPI1->CR2 |= SPI_CR2_TXDMAEN;



	RCC->AHBENR |= RCC_AHBENR_DMA1EN;				// Вмикаємо тактування на DMA

	DMA1_CSELR->CSELR &= ~DMA_CSELR_C3S;			// Очищаємо біти в регістрі CSELR на каналі 3
	DMA1_CSELR->CSELR |= (0b0001 << DMA_CSELR_C3S_Pos);	// Для каналу 3 вписуємо 0b0001 для вибору SP1_TX

	DMA1_Channel3->CCR &= ~DMA_CCR_MEM2MEM;			// Вимикаємо режим Memmory to Memmory

	DMA1_Channel3->CCR |= DMA_CCR_PL_1;				// Ставимо середній приорітет

	DMA1_Channel3->CCR &= ~DMA_CCR_MSIZE;			// Очищаємо біти для того щоб обрати 8 бітний режим передачі
	DMA1_Channel3->CCR &= ~DMA_CCR_PSIZE;			// Очищаємо біти для того щоб обрати 8 бітний режим передачі

	DMA1_Channel3->CCR |= DMA_CCR_MINC;				// Вмикаємо інкрементацію адресу памʼяті
	DMA1_Channel3->CCR &= ~DMA_CCR_PINC;			// Вимикаємо інкрементаціяю адресу переферії

	DMA1_Channel3->CCR &= ~DMA_CCR_CIRC;			// Вимикаємо циклічний режим

	DMA1_Channel3->CCR |= DMA_CCR_DIR;				// Вмикаємо читання з памʼяті, тобто Memory to Peripheral

	DMA1_Channel3->CCR |= DMA_CCR_TEIE;				// Вмикаємо переривання на помилку
	DMA1_Channel3->CCR &= ~DMA_CCR_HTIE;			// Вимикаємо переривання на половину передачі
	DMA1_Channel3->CCR |= DMA_CCR_TCIE;				// Вмикаємо переривання на завершення передачі


	NVIC_EnableIRQ(DMA1_Channel2_3_IRQn);

	DMA1_Channel3->CPAR = (uint32_t)&SPI1->DR;

	SPI1->CR1 |= SPI_CR1_SPE;

}

void InitST7789V3(rotation parameter){

SPI1->CR1 |= SPI_CR1_BIDIOE;

InitDMA();

uint8_t command;
//RES_HIGH;
	// SWRESET
command = SWRESET;
WriteCmd(command);
HAL_Delay(150);
	// Display off
command = DISPOFF;
WriteCmd(command);
	// Sleep out
command = SLPOUT;
WriteCmd(command);
HAL_Delay(5);
	// Normal display mode
command  = NORON;
WriteCmd(command);
	// Display inversion off
command = INVON;
WriteCmd(command);
	// Tearing effects line off
command = TEOFF;
WriteCmd(command);
	// Idle mode  off
command = IDMOFF;
WriteCmd(command);
	// Interface pixel format (COLMOD)
command = COLMOD;
WriteCmd(command);
command = bit_interface;
WriteParameters(&command, 1);

	// Display on
command = DISPON;
WriteCmd(command);
BLK_HIGH;

// CTRL Display
command = 0x53;
WriteCmd(command);
command =  (1<<5)   // BCTRL = 1 (Brightness Control On)
       | (1<<3) // DD = 0 (Dimming off)
       | (1<<2); // BL = 1 (Backlight On);
WriteParameters(&command, 1);

DataAccessControl(parameter);

switch(parameter){

case(X_Y_Exchange_X_Mirror):
		X_OFFSET = 20;
		Y_OFFSET = 0;
		WIDTH = 280 - 1;
		HEIGHT = 240 - -1;
		break;
default :
	break;

}

Init_BLK_PWM();

}

void SetPixel(uint16_t x_position, uint16_t y_position, uint8_t red, uint8_t green, uint8_t blue){

	if (red > 63)	red = 63;
	if (green > 63)	green = 63;
	if (blue > 63) 	blue = 63;

	red = 	(red << 2);
	green = (green << 2);
	blue = 	(blue << 2);

	uint8_t cmd;
	CS_LOW;

	cmd = CASET;
	WriteCmd(cmd);

	uint8_t caset[4];
	caset[0] = (x_position + X_OFFSET) >> 8;
	caset[1] = (x_position + X_OFFSET);
	caset[2] =	(x_position + X_OFFSET) >> 8;
	caset[3] =	(x_position + X_OFFSET);

	WriteParameters(caset, 4);


	cmd = RASET;
	WriteCmd(cmd);

	uint8_t raset[4];
	raset[0] = (y_position + Y_OFFSET) >> 8;
	raset[1] = (y_position + Y_OFFSET);
	raset[2] = (y_position + Y_OFFSET) >> 8;
	raset[3] = (y_position + Y_OFFSET);
	WriteParameters(raset, 4);

	cmd = RAMWR;
	WriteCmd(cmd);

	uint8_t pixels[3] = {red, green, blue};
	WriteParameters(pixels, 3);

	CS_HIGH;
}

