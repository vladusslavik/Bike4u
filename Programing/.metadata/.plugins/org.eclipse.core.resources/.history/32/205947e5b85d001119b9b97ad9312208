#include "pb-03f.h"

extern UART_HandleTypeDef huart2;

uint8_t ble_buf[247];


void Enter_AT_Mode_During_Connect(void) {
    // 1. Чекаємо секунду тиші, щоб модуль зрозумів, що потік даних закінчився
    HAL_Delay(1000);

    // 2. Шлемо ТІЛЬКИ три плюси. Жодних \r\n !
    uint8_t escape_cmd[] = "+++";
    HAL_UART_Transmit(&huart2, escape_cmd, 3, 100);

    // 3. Знову чекаємо секунду тиші, поки модуль переварить escape-послідовність
    HAL_Delay(1000);
}

