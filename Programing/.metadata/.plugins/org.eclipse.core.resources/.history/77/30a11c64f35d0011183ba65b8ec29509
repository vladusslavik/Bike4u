#pragma once

#include "main.h"

extern UART_HandleTypeDef huart2;
#define HUART_BLE	&huart2
#define UART_BLE	USART2



//======================================================================
// Basic AT commands
//======================================================================
#define AT			"AT\r\n"
#define RST		"AT+RST\r\n"
#define	SLEEP		"AT+SLEEP\r\n"
#define ECHO_ON		"ATE1\r\n"
#define ECHO_OFF	"ATE0\r\n"

// Допоміжні макроси для перетворення чисел у рядок
#define STR_HELPER(x) #x
#define STR(x) STR_HELPER(x)

//======================================================================
// Hardware & Network Settings
//======================================================================
#define baudrate    500000
#define databits    8
#define stopbits    1
#define parity      0

#define UARTCFG     "AT+UARTCFG=" STR(baudrate) "," STR(databits) "," STR(stopbits) "," STR(parity) "\r\n"
#define UART_CONFIG	"AT+UARTCFG?\r\n"

#define interval	2000
#define	BLEADVINTV	"AT+BLEADVINTV=" STR(interval) "\r\n"

#define DEVICE_NAME	Bike4u
#define BLENAME		"AT+BLENAME=" STR(DEVICE_NAME) "\r\n"

#define BLETXUUID	"AT+BLETXUUID?\r\n"
#define BLERXUUID	"AT+BLERXUUID?\r\n"
//======================================================================
// BLE Control Commands
//======================================================================

#define BLEMODE		"AT+BLEMODE=0\r\n"
#define BLEMTU		"AT+BLEMTU=247\r\n"
#define BLESTATE	"AT+BLESTATE?\r\n"
#define BLEDISCON	"AT+BLEDISCON\r\n"
#define	BLEADVEN	"AT+BLEADVEN=1\r\n"


//======================================================================
// Transparent Mode (Passthrough)
//======================================================================
#define	TRANSPARENT	"+++"
#define TRANSENTER	"AT+TRANSENTER\r\n"


void Init_BLE(void);
void Write(uint16_t delay, const char *COMMAND);
void Enter_AT_Mode_During_Connect(void);
